# Copy to .env, fill in, then:  set -a; source .env; set +a
# NEVER commit .env — it is gitignored.

# Robinhood login (read-only portfolio access; StockSage never places orders)
ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=your-password

# If your Robinhood account uses app-based 2FA, paste the TOTP secret shown
# when you set up the authenticator app (recommended: enable 2FA!).
ROBINHOOD_MFA_SECRET=

# Optional overrides
# STOCKSAGE_DB=~/.stocksage/stocksage.db
